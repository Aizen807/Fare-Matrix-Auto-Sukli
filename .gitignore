# ============================================================
# .gitignore - Fare Matrix Auto Sukli
# ============================================================

# -------------------------------
# AutoHotkey specific
# -------------------------------
*.exe
*.bin
*.ahk.bak
*.ahk~
*.bak
*.tmp

# -------------------------------
# Windows specific
# -------------------------------
# Windows thumbnail cache
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db

# Windows image cache
*.png.metadata

# Windows Explorer
desktop.ini
$RECYCLE.BIN/

# Windows shortcuts
*.lnk

# Windows registry exports
*.reg

# -------------------------------
# User-specific files
# -------------------------------
*.user
*.userosscache
*.sln.docstates
*.suo
*.cache
*.ilk
*.log
*.tlog

# Visual Studio
.vs/
.vscode/
*.vsp
*.vspx

# -------------------------------
# Build results
# -------------------------------
[Dd]ebug/
[Dd]ebugPublic/
[Rr]elease/
[Rr]eleases/
x64/
x86/
build/
bld/
[Bb]in/
[Oo]bj/
[Ll]og/

# -------------------------------
# IDE files
# -------------------------------
# Visual Studio Code
.vscode/
*.code-workspace

# Sublime Text
*.sublime-project
*.sublime-workspace

# Atom
.atom/

# Notepad++
*.npp

# -------------------------------
# OS specific
# -------------------------------
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes
*.swp
*.swo

# Linux
*~
.directory
*.pid
*.seed
*.pid.lock

# -------------------------------
# Backup and temp files
# -------------------------------
*.backup
*.old
*.orig
*.rej
*.patch
*.diff
*.log
*.tmp
*.temp
*.cache
*.cached

# -------------------------------
# Project specific
# -------------------------------
# User screenshots (keep the folder, not the images)
sukli_images/*.png
sukli_images/*.jpg
sukli_images/*.jpeg
!sukli_images/README.txt
!sukli_images/.gitkeep

# Config backups
sukli_config.ini.bak
sukli_config.ini.old
sukli_config.ini.tmp

# Temporary AHK scripts
*_temp.ahk
*_test.ahk

# -------------------------------
# Archives and packages
# -------------------------------
*.zip
*.7z
*.rar
*.tar
*.gz
*.bz2
*.xz

# -------------------------------
# Environment and credentials
# -------------------------------
.env
.env.local
.env.*.local
*.pem
*.key
*.crt
*.p12
*.pfx
*.p8

# -------------------------------
# Dependency directories
# -------------------------------
# AutoHotkey dependencies (if you ever use any)
/Lib/
/Include/
/ThirdParty/

# -------------------------------
# Logs and databases
# -------------------------------
*.log
*.sqlite
*.sqlite3
*.db

# -------------------------------
# Compiled AutoHotkey files
# -------------------------------
*.exe
*.aex
*.ahk.bin

# -------------------------------
# Documents and reports
# -------------------------------
*.pdf
*.doc
*.docx
*.xls
*.xlsx
*.ppt
*.pptx

# -------------------------------
# Screenshots (user-created)
# -------------------------------
# Keep the folder, ignore all images except the README
sukli_images/
!sukli_images/README.txt
!sukli_images/.gitkeep

# But keep the folder structure visible
!.gitkeep

# -------------------------------
# Package lock files (if any)
# -------------------------------
package-lock.json
yarn.lock
pnpm-lock.yaml

# -------------------------------
# Node modules (if you ever add Node.js)
# -------------------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# -------------------------------
# Python specific (if you ever add Python)
# -------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
ENV/
env.bak/
venv.bak/

# -------------------------------
# Coverage and test results
# -------------------------------
coverage/
*.cover
*.pyc
*.pytest_cache/

# -------------------------------
# System files
# -------------------------------
*.dll
*.sys
*.ini.bak
*.cfg.bak
